<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Trakto.ViewModels.Timeline"
             x:Class="Trakto.Views.Timeline.TimelineClipView"
             x:DataType="vm:TimelineClipViewModel">
             
    <UserControl.Styles>
        <Style Selector="Border.clip">
            <Setter Property="BorderBrush" Value="#717cb4" />
        </Style>
        <Style Selector="Border.clip.selected">
            <Setter Property="BorderBrush" Value="White" />
        </Style>
    </UserControl.Styles>

    <Border Background="#4d5382" Classes="clip" Classes.selected="{Binding IsSelected}" BorderThickness="1" CornerRadius="3" 
            Width="{Binding Width}" Height="40" VerticalAlignment="Center"
            PointerPressed="OnPointerPressed">
        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="11" 
                   VerticalAlignment="Center" Margin="5,0,0,0" TextTrimming="CharacterEllipsis" />
    </Border>
    
</UserControl>
