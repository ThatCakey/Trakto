<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Trakto.ViewModels"
             xmlns:visive="using:Visive"
             x:Class="Trakto.Views.MediaLibraryView"
             x:DataType="vm:MediaLibraryViewModel">

    <Grid Background="#1d1e20" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Background="#2b2d30" BorderBrush="#3f4146" BorderThickness="0,0,0,1" Padding="10">
            <TextBlock Text="Media Library" Foreground="LightGray" FontWeight="Bold" FontSize="14" />
        </Border>

        <ScrollViewer Grid.Row="1" Padding="10">
            <ItemsControl ItemsSource="{Binding MediaItems}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="visive:VideoObject">
                        <Border Background="#252627" BorderBrush="#3f4146" BorderThickness="1" CornerRadius="5" Width="120" Height="100" Margin="5" Padding="5">
                            <Grid RowDefinitions="*,Auto">
                                <!-- Thumbnail Placeholder -->
                                <Border Grid.Row="0" Background="#1a1b1c" CornerRadius="3" Margin="0,0,0,5">
                                    <TextBlock Text="🎬" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" />
                                </Border>
                                <TextBlock Grid.Row="1" Text="{Binding Name}" Foreground="White" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
