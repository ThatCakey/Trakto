<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Trakto.ViewModels"
             xmlns:tvm="using:Trakto.ViewModels.Timeline"
             xmlns:tv="using:Trakto.Views.Timeline"
             x:Class="Trakto.Views.TimelineView"
             x:DataType="vm:TimelineViewModel">
    <Grid Background="#161718" RowDefinitions="Auto,*,Auto">
        
        <!-- Header: Toolbar & Play Controls -->
        <Border Grid.Row="0" Background="#2b2d30" BorderBrush="#3f4146" BorderThickness="0,0,0,1" Padding="5,5">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                <Button Content="⏮" Width="35" Height="30" Background="Transparent" Foreground="LightGray" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Button Content="▶" Command="{Binding PlayCommand}" IsVisible="{Binding IsNotPlaying}" Width="35" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Button Content="⏸" Command="{Binding PauseCommand}" IsVisible="{Binding IsPlaying}" Width="35" Height="30" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                <Button Content="⏭" Width="35" Height="30" Background="Transparent" Foreground="LightGray" BorderThickness="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                
                <Separator Background="#3f4146" Margin="0,0" />
                <TextBlock Text="{Binding CurrentTime, StringFormat=\{0:F2\}s}" Foreground="White" VerticalAlignment="Center" Width="60" TextAlignment="Center" />
            </StackPanel>
        </Border>
        
        <!-- Timeline Track Area -->
        <ScrollViewer x:Name="MainScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      PointerWheelChanged="OnPointerWheelChanged">
            <Grid Width="{Binding TimelineWidth}" HorizontalAlignment="Left">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" /> <!-- Ruler -->
                    <RowDefinition Height="*" /> <!-- Tracks -->
                </Grid.RowDefinitions>

                <!-- Ruler Area -->
                <Border Grid.Row="0" Background="#1d1e20" BorderBrush="#2b2d30" BorderThickness="0,0,0,1" x:Name="RulerBorder">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Top left corner empty space -->
                        <Border Grid.Column="0" Background="#252627" BorderBrush="#2b2d30" BorderThickness="0,0,1,0" />
                        
                        <!-- The actual clickable ruler -->
                        <Canvas Grid.Column="1" Background="Transparent" 
                                PointerPressed="OnRulerPointerPressed"
                                PointerMoved="OnRulerPointerMoved"
                                PointerReleased="OnRulerPointerReleased">
                            <!-- High-Performance Ruler -->
                            <tv:RulerControl PixelsPerSecond="{Binding PixelsPerSecond}" 
                                             MaxTime="{Binding MaxTime}" 
                                             Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType=Canvas}}"
                                             Height="30" />
                        </Canvas>
                    </Grid>
                </Border>

                <!-- Tracks -->
                <ItemsControl x:Name="TracksControl" Grid.Row="1" ItemsSource="{Binding Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tvm:TimelineTrackViewModel">
                            <!-- A single track -->
                            <Grid Height="60">
                                <Grid.ColumnDefinitions>
                                    <!-- Track Header -->
                                    <ColumnDefinition Width="150" />
                                    <!-- Track Body -->
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <!-- Track Header UI -->
                                <Border Grid.Column="0" Background="#252627" BorderBrush="#2b2d30" BorderThickness="0,0,1,1" Padding="10">
                                    <TextBlock Text="{Binding TrackName}" Foreground="LightGray" VerticalAlignment="Center" />
                                </Border>
                                
                                <!-- Track Content (Canvas containing clips) -->
                                <Border Grid.Column="1" Background="#1a1b1c" BorderBrush="#2b2d30" BorderThickness="0,0,0,1">
                                    <ItemsControl ItemsSource="{Binding Clips}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <Canvas DragDrop.AllowDrop="True"
                                                        Background="Transparent"
                                                        DragDrop.DragOver="OnTrackDragOver"
                                                        DragDrop.Drop="OnTrackDrop" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="tvm:TimelineClipViewModel">
                                                <tv:TimelineClipView />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                        <ItemsControl.ItemContainerTheme>
                                            <!-- Position the clip horizontally on the canvas based on its X property -->
                                            <ControlTheme TargetType="ContentPresenter" x:DataType="tvm:TimelineClipViewModel">
                                                <Setter Property="(Canvas.Left)" Value="{Binding X}" />
                                                <Setter Property="(Canvas.Top)" Value="10" />
                                            </ControlTheme>
                                        </ItemsControl.ItemContainerTheme>
                                    </ItemsControl>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                
                <!-- Playhead Overlay Layer -->
                <Canvas Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
                    <!-- The red playhead line -->
                    <Rectangle Fill="Red" Width="2" Height="1000" Canvas.Left="{Binding PlayheadX}" Canvas.Top="0" />
                    <!-- Playhead triangle head -->
                    <Path Fill="Red" Data="M 0,0 L 10,0 L 5,10 Z" Canvas.Left="{Binding PlayheadX}" Canvas.Top="20">
                        <Path.RenderTransform>
                            <TranslateTransform X="-4" />
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- Footer: Zoom Controls -->
        <Border Grid.Row="2" Background="#2b2d30" BorderBrush="#3f4146" BorderThickness="0,0.5,0,0" Padding="5,5">
            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                <TextBlock Text="Zoom:" Foreground="LightGray" VerticalAlignment="Center" />
                <Slider Minimum="10" Maximum="500" Value="{Binding PixelsPerSecond, Mode=TwoWay}" Width="150" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
