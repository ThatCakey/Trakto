<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Trakto.ViewModels"
             x:Class="Trakto.Views.TimelineView"
             x:DataType="vm:TimelineViewModel">
    <Grid Background="#1d1e20" RowDefinitions="Auto,*">
        <!-- Scrubber Header -->
        <Border Grid.Row="0" Background="#2b2d30" BorderBrush="#3f4146" BorderThickness="0,0,0,1" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Playhead:" Foreground="LightGray" VerticalAlignment="Center" />
                <Slider Minimum="0" Maximum="{Binding MaxTime}" Value="{Binding CurrentTime, Mode=TwoWay}" Width="400" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CurrentTime, StringFormat=\{0:F2\}s}" Foreground="White" VerticalAlignment="Center" Width="60" />
            </StackPanel>
        </Border>
        
        <!-- Track Area (Placeholder for now) -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas Width="1000" Height="200" Background="#161718">
                <!-- We will draw Visive clips here in the future -->
                <TextBlock Text="Timeline Tracks" Foreground="#3f4146" Canvas.Left="10" Canvas.Top="10" />
            </Canvas>
        </ScrollViewer>
    </Grid>
</UserControl>
